{
  "name": "centro-agentes",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "compartido",
    "agente",
    "web"
  ],
  "scripts": {
    "test": "NODE_OPTIONS='--experimental-sqlite --no-warnings=ExperimentalWarning' vitest run",
    "lint": "eslint .",
    "build": "tsc -b compartido agente && tsc -p web",
    "instantanea": "NODE_OPTIONS='--experimental-sqlite --no-warnings=ExperimentalWarning' tsx agente/src/cli.ts instantanea",
    "codex:task": "bash scripts/dev/codex-task.sh",
    "codex:monitor": "node scripts/dev/codex-monitor.mjs",
    "build:web": "vite build web",
    "dev:web": "vite web",
    "panel": "npm run build:web && NODE_OPTIONS='--experimental-sqlite --no-warnings=ExperimentalWarning' tsx agente/src/cli.ts panel"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "jsdom": "^28.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
